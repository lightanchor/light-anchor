#!/bin/zsh
# commit-msg 钩子：校验提交主题符合 Conventional Commits。
# 规范全文见 docs/development.md「提交信息」；应急绕过：git commit --no-verify。
set -euo pipefail

msg_file=$1
subject=$(head -n1 "$msg_file")

# 合并、还原与 rebase 整理提交放行。
case $subject in
  (Merge\ *|Revert\ *|fixup!\ *|squash!\ *) exit 0 ;;
esac

types='feat|fix|refactor|perf|style|test|docs|build|ci|chore|revert'
pattern="^(${types})(\\([a-z0-9][a-z0-9-]*\\))?!?: ."

fail() {
  print -ru2 -- "✗ $1"
  print -ru2 -- "  主题行：$subject"
  print -ru2 -- "  期望：type(scope): 主题 —— type ∈ {feat fix refactor perf style test docs build ci chore revert}，scope 小写可省略，整行 ≤ 72 字符，结尾不加句号。"
  print -ru2 -- "  示例：fix(sidebar): 收展动画钉在 sidebarAnchored 上"
  print -ru2 -- "  规范：docs/development.md「提交信息」；应急绕过：git commit --no-verify"
  exit 1
}

[[ $subject =~ $pattern ]] || fail "提交主题不符合 Conventional Commits 格式"
(( ${#subject} <= 72 )) || fail "提交主题超过 72 字符（当前 ${#subject}）"
[[ ${subject[-1]} != "." && ${subject[-1]} != "。" ]] || fail "提交主题结尾不要句号"
